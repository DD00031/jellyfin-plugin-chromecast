<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored copy of https://github.com/Tapanila/SharpCaster (MIT, see LICENSE.txt) with one
    small patch - see PATCH.md in this folder for exactly what and why. Trimmed down from the
    upstream repo to just the library project; tests/samples/CI are not needed here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sharpcaster</RootNamespace>
    <AssemblyName>Sharpcaster</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NoWarn>1701;1702;1591;1707;CA1819;CA1003;CA1031;CA1056;CA1716;CA1720;CA2227;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
    <PackageReference Include="Zeroconf" Version="3.7.16" />
  </ItemGroup>

</Project>
